#: includes/Modules/WhiteLabel/settings-template.php:143
msgid "Hides the \"Help\" tab at the top right of every admin page."
msgstr "Masque l'onglet « Aide » en haut à droite de chaque page admin."

#: includes/Modules/WhiteLabel/settings-template.php:157
msgid "Hide the Screen Options button"
msgstr "Masquer le bouton Options de l'écran"

#: includes/Modules/WhiteLabel/settings-template.php:158
msgid "Hides the \"Screen Options\" tab at the top right of every admin page."
msgstr "Masque l'onglet « Options de l'écran » en haut à droite de chaque page admin."

#: includes/Modules/WhiteLabel/settings-template.php:172
msgid "Remove the greeting"
msgstr "Supprimer la salutation"

#: includes/Modules/WhiteLabel/settings-template.php:173
msgid "Removes \"Howdy,\" / \"Hello,\" in front of the logged-in user name, whatever the language."
msgstr "Supprime « Howdy, » / « Bonjour, » devant le nom de l'utilisateur connecté, quelle que soit la langue."

#: includes/Modules/WhiteLabel/settings-template.php:187
msgid "Hide the admin bar on the site"
msgstr "Masquer la barre d'administration sur le site"

#: includes/Modules/WhiteLabel/settings-template.php:188
msgid "Completely hides the admin bar for site visitors (front end)."
msgstr "Cache entièrement la barre d'administration pour les visiteurs du site (front-end)."

#: includes/Modules/WhiteLabel/settings-template.php:211
msgid "Host avatars locally instead of relying on Gravatar."
msgstr "Hébergez les avatars localement plutôt que de dépendre de Gravatar."

#: includes/Modules/WhiteLabel/settings-template.php:218
msgid "Enable local avatars"
msgstr "Activer les avatars locaux"

#: includes/Modules/WhiteLabel/settings-template.php:219
msgid "Adds a \"Local avatar\" field to every profile. The uploaded avatar takes priority; otherwise WordPress falls back to Gravatar (default behavior)."
msgstr "Ajoute un champ « Avatar local » sur chaque profil. L'avatar téléversé est prioritaire ; à défaut, WordPress retombe sur Gravatar (comportement par défaut)."

#: includes/Modules/WhiteLabel/settings-template.php:241
msgid "Visual hiding only: every feature stays active on the server side. These checkboxes declutter the screen, they do not remove any permission."
msgstr "Masquage visuel uniquement : chaque fonctionnalité reste active côté serveur. Ces cases épurent l'écran, elles ne retirent aucun droit."

#: includes/Modules/WhiteLabel/settings-template.php:242
msgid "Declutter the user profile page (profile.php) by hiding unneeded options."
msgstr "Épurez la page de profil des utilisateurs (profile.php) en masquant les options superflues."

#: includes/Modules/WhiteLabel/settings-template.php:249
msgid "Hide the admin color scheme"
msgstr "Masquer le jeu de couleurs de l'administration"

#: includes/Modules/WhiteLabel/settings-template.php:250
msgid "Removes the admin color scheme picker."
msgstr "Supprime le sélecteur de thème de couleurs de l'admin."

#: includes/Modules/WhiteLabel/settings-template.php:264
msgid "Hide keyboard shortcuts"
msgstr "Masquer les raccourcis clavier"

#: includes/Modules/WhiteLabel/settings-template.php:265
msgid "Removes the option to enable comment moderation shortcuts."
msgstr "Supprime l'option d'activation des raccourcis de modération des commentaires."

#: includes/Modules/WhiteLabel/settings-template.php:279
msgid "Hide the Toolbar option"
msgstr "Masquer l'option Barre d'outils"

#: includes/Modules/WhiteLabel/settings-template.php:280
msgid "Removes the \"Show Toolbar when viewing site\" checkbox."
msgstr "Supprime la case « Afficher la barre d'outils lorsque vous visitez le site »."

#: includes/Modules/WhiteLabel/settings-template.php:294
msgid "Hide application passwords"
msgstr "Masquer les mots de passe d'application"

#: includes/Modules/WhiteLabel/settings-template.php:295
msgid "Hides the \"Application Passwords\" section (the feature stays active on the server side)."
msgstr "Masque la section « Mots de passe d'application » (la fonctionnalité reste active côté serveur)."

#: includes/Modules/WhiteLabel/settings-template.php:309
msgid "Hide the language selector"
msgstr "Masquer le sélecteur de langue"

#: includes/Modules/WhiteLabel/settings-template.php:310
msgid "Removes the \"Language\" row (user locale)."
msgstr "Supprime la ligne « Langue » (locale de l'utilisateur)."

#: includes/Modules/WhiteLabel/settings-template.php:324
msgid "Hide the biographical info"
msgstr "Masquer les informations biographiques"

#: includes/Modules/WhiteLabel/settings-template.php:325
msgid "Removes the \"Biographical Info\" field from the \"About Yourself\" section."
msgstr "Supprime le champ « Informations biographiques » de la section « À propos de vous »."

#: includes/Modules/WhiteLabel/settings-template.php:339
msgid "Hide sessions"
msgstr "Masquer les sessions"

#: includes/Modules/WhiteLabel/settings-template.php:340
msgid "Removes the \"Log Out Everywhere Else\" button."
msgstr "Supprime le bouton « Se déconnecter partout ailleurs »."

#: includes/Modules/WhiteLabel/settings-template.php:354
msgid "Hide the editor options"
msgstr "Masquer les options de l'éditeur"

#: includes/Modules/WhiteLabel/settings-template.php:355
msgid "Removes \"Disable the visual editor\" and \"Syntax Highlighting\"."
msgstr "Supprime « Désactiver l'éditeur visuel » et « Coloration syntaxique »."

#: includes/Modules/WhiteLabel/settings-template.php:378
msgid "Customize the texts displayed in the footer of the WordPress admin."
msgstr "Personnalisez les textes affichés dans le pied de page de l'administration WordPress."

#: includes/Modules/WhiteLabel/settings-template.php:384
msgid "Footer left text"
msgstr "Texte gauche du footer"

#: includes/Modules/WhiteLabel/settings-template.php:384
msgid "HTML is filtered like post content: scripts and event attributes are removed when saving."
msgstr "Le HTML est filtré comme un contenu d'article : scripts et attributs d'événement sont retirés à l'enregistrement."

#: includes/Modules/WhiteLabel/settings-template.php:386
msgid "Supports basic HTML (links, em/strong tags). Leave empty to keep the default WordPress value."
msgstr "Supporte le HTML basique (liens, balises em/strong). Laissez vide pour garder la valeur WordPress par défaut."

#: includes/Modules/WhiteLabel/settings-template.php:392
msgid "Hide the WordPress version (right text)"
msgstr "Masquer la version WordPress (texte droit)"

#: includes/Modules/WhiteLabel/settings-template.php:393
msgid "Removes the \"Version X.X.X\" notice at the bottom right of every admin page."
msgstr "Supprime l'indication « Version X.X.X » en bas à droite de chaque page admin."

#: includes/Modules/WhiteLabel/settings-template.php:406
msgid "Footer right text (if not hidden)"
msgstr "Texte droit du footer (si non masqué)"

#: includes/Modules/WhiteLabel/settings-template.php:408
msgid "Replaces \"Version X.X.X\". Leave empty to keep the default WordPress value."
msgstr "Remplace « Version X.X.X ». Laissez vide pour garder la valeur WordPress par défaut."

