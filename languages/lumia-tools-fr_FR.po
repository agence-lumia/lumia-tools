msgid "No AVIF is lighter than the original, or the format cannot be converted (animated images)."
msgstr "Aucun AVIF n'est plus léger que l'original, ou le format ne peut pas être converti (images animées)."

#: includes/Modules/ImageOptimizer/settings-template.php:279
msgid "The AVIF could not be generated. Start tries again."
msgstr "L'AVIF n'a pas pu être généré. « Lancer l'optimisation » réessaie."

#: includes/Modules/ImageOptimizer/settings-template.php:280
msgid "Excluded"
msgstr "Exclu"

#: includes/Modules/ImageOptimizer/settings-template.php:280
msgid "Served in their original format: the switch of the media item, or an excluded name suffix."
msgstr "Servies dans leur format d'origine : l'interrupteur du média, ou un suffixe de nom exclu."

#: includes/Modules/ImageOptimizer/settings-template.php:286
msgid "Generates the AVIF version of the images already in the media library, in the background: you can leave this page, the queue keeps working."
msgstr "Génère la version AVIF des images déjà présentes dans la médiathèque, en arrière-plan : vous pouvez quitter cette page, la file d'attente continue de tourner."

