# Static analysis, level 8 without a baseline: final level, see docs/core.md (tooling).
# The szepeviktor/phpstan-wordpress extension is loaded automatically (phpstan/extension-installer).
# Templates (templates/, settings-template.php) are included from an Admin method: their
# scope ($this, $tab, $module...) is invisible to the analysis, so they are left to PHPCS.
parameters:
    level: 8
    paths:
        - lumia-tools.php
        - uninstall.php
        - includes
    excludePaths:
        - includes/Modules/*/settings-template.php
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
