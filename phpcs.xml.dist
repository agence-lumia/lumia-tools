<?xml version="1.0"?>
<ruleset name="Studio Kyne Mini Tools">
	<description>Standards WordPress (WPCS) et compatibilité PHP 7.4+ pour l'extension.</description>

	<!-- Fichiers analysés -->
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<!-- Banc de test Docker (mu-plugin d'authentification, graine, capture) : jamais distribué, pas du code du plugin. -->
	<exclude-pattern>*/tools/e2e/*</exclude-pattern>

	<!-- Options : PHP uniquement, chemins relatifs, parallélisme, couleurs -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Standard WordPress complet (Core + Docs + Extra) -->
	<rule ref="WordPress">
		<!-- Le projet est documenté en français, sans docblocs systématiques : on ne bloque pas la CI dessus. -->
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting"/>
		<!-- Le nom des fichiers suit PSR-4 (Module.php, RateLimiter.php), pas class-xxx.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Interdit les instructions de contrôle sans accolades sur une ligne : déjà couvert par Generic.ControlStructures. -->
		<exclude name="Universal.ControlStructures.DisallowLonelyIf"/>
		<!-- Les tableaux courts [] sont utilisés partout. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Git normalise les fins de ligne (autocrlf) : le poste Windows verrait 45 faux positifs. -->
		<exclude name="Generic.Files.LineEndings"/>
		<!-- Les propriétés lues sont celles d'objets WordPress et DOM (WP_Post, DOMNode…) : leur casse n'est pas la nôtre. -->
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
	</rule>

	<!-- Les gabarits sont inclus depuis une méthode d'Admin : leurs variables ne sont pas globales. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/templates/*</exclude-pattern>
		<exclude-pattern>*/settings-template.php</exclude-pattern>
		<exclude-pattern>*/uninstall.php</exclude-pattern>
	</rule>

	<!-- Même raison : $tab ou $wp_version y sont des locales de la méthode, et $this y désigne l'instance d'Admin. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/templates/*</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibility.FunctionDeclarations.NewClosure.ThisFoundOutsideClass">
		<exclude-pattern>*/templates/*</exclude-pattern>
	</rule>

	<!-- uninstall.php est procédural par contrat WordPress : ses variables de boucle ne sont pas des globales à protéger. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/uninstall.php</exclude-pattern>
	</rule>

	<!-- Domaine de traduction -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="studio-kyne-mini-tools"/>
			</property>
		</properties>
	</rule>

	<!-- Préfixes attendus pour tout ce qui atterrit dans l'espace global -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="skmt"/>
				<element value="SKMT"/>
				<element value="StudioKyne"/>
			</property>
		</properties>
	</rule>

	<!-- Compatibilité PHP : version minimale déclarée dans l'en-tête -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Version WordPress minimale (fonctions dépréciées) -->
	<config name="minimum_wp_version" value="6.0"/>
</ruleset>
