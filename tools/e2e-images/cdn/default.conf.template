# Bench only (`cdn`, `cdn-noquery`, `cdn-vary` stacks): a caching reverse proxy in front of the
# template's nginx, seen by the plugin as Cloudflare (`cf-ray`, `cf-cache-status`). Rendered by
# the nginx image's envsubst at start (only these two variables are replaced):
#   CDN_IGNORE  response headers the cache ignores. With `Vary` (cdn, cdn-noquery): the first
#               response cached for an image URL goes to every client, as on Cloudflare
#               without "Vary for images". Without it (cdn-vary): one entry per Accept value.
#   CDN_SKIP    `0` caches every image URL; `$args` (cdn-noquery) never caches a URL with a
#               query string, like a zone whose cache ignores those: the self-test's URLs
#               then bypass the cache while the plain image URLs are cached.
proxy_cache_path /var/cache/bench-cdn keys_zone=bench_cdn:10m max_size=100m inactive=1h use_temp_path=off;

server {
    listen 80 default_server;
    server_name _;

    # Media uploads go through the proxy too (nginx's default is 1 MB).
    client_max_body_size 64m;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # add_header is not inherited by a location that has its own: repeated in each one.

    # Images: cached by URL only (the default key includes the query string), Vary ignored.
    location ~* \.(?:jpe?g|png|gif|webp|avif)$ {
        proxy_pass http://web-nginx:80;
        proxy_cache bench_cdn;
        proxy_cache_valid 200 1h;
        proxy_ignore_headers ${CDN_IGNORE};
        proxy_cache_bypass ${CDN_SKIP};
        proxy_no_cache ${CDN_SKIP};
        add_header cf-ray "bench-$request_id" always;
        add_header cf-cache-status $upstream_cache_status always;
    }

    # Everything else (WordPress, wp-admin, admin-ajax) goes through uncached.
    location / {
        proxy_pass http://web-nginx:80;
        add_header cf-ray "bench-$request_id" always;
        add_header cf-cache-status DYNAMIC always;
    }
}
