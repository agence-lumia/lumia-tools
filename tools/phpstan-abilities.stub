<?php
/**
 * PHPStan stubs for the plugins the lumia/* abilities call (FluentSnippets,
 * Rank Math), which are not part of the repository. They declare only what
 * includes/Modules/McpConnect/Abilities/ calls, with the signatures read in
 * FluentSnippets 10.58 and Rank Math 1.0.280. Tooling file only, listed under
 * `scanFiles` in phpstan.neon.dist; the `.stub` extension keeps it out of PHPCS.
 */

namespace FluentSnippets\App\Helpers {
	class Helper {
		/**
		 * @param array<string, mixed> $data meta, code.
		 * @return string|\WP_Error File name of the new snippet.
