		/**
		 * @param array<string, mixed> $data meta, code, file_name, reactivate.
		 * @return string|\WP_Error
		 */
		public static function updateSnippet( $data ) {}

		/**
		 * @return array<string, mixed>
		 */
		public static function getIndexedConfig( $cached = true ) {}
	}
}

namespace FluentSnippets\App\Model {
	class Snippet {
		/** @param array<string, mixed> $args */
		public function __construct( $args = [] ) {}

		/**
		 * @param array<string, mixed> $args
		 * @return array<int, array{meta: array<string, mixed>, code: string, file: string, status: string}>
		 */
		public function get( $args = [] ) {}

		/**
		 * @return array{meta: array<string, mixed>, code: string, file: string, status: string}|\WP_Error
		 */
		public function findByFileName( $fileName ) {}

		/**
		 * @param array<string, mixed> $metaData
		 * @return string|\WP_Error
		 */
		public function updateSnippet( $fileName, $code, $metaData ) {}

		/**
		 * @return true|\WP_Error
		 */
		public function deleteSnippet( $fileName ) {}
	}
}

